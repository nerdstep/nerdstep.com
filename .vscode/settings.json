{
  // Formatting: oxfmt (extension `oxc.oxc-vscode`, binary from devDependencies).
  // Linting: Biome (until oxlint migration).
  // formatOnSave is off so codeActionsOnSave can pin the order:
  // lint fixes first, oxfmt formatting last.
  "editor.formatOnSave": false,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports": "never",
    "source.format.oxc": "always"
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.quickSuggestions": {
    "strings": true
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "tailwindCSS.colorDecorators": false,
  "tailwindCSS.experimental.classRegex": [["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]],
  "js/ts.tsdk.path": "node_modules\\typescript\\lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true
}
