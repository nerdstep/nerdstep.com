{
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "target": "ES2024",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowJs": false,

    // Bundler mode
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // Enabling verbatimModuleSyntax can result in server bundles leaking
    // into client bundles. It is recommended to keep this option disabled.
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noEmit": true,

    // Linting
    "strict": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
