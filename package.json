{
  "name": "nerdstep.com",
  "version": "1.0.0",
  "private": true,
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run lint",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint": "npm run ts:check && npm run format:check && npm run lint:check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:check": "oxlint . && npm run lint:type-aware",
    "lint:type-aware": "oxlint --config .oxlintrc.type-aware.json .",
    "lint:fix": "oxlint --fix . && oxfmt . && npm run lint:type-aware",
    "ts:check": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.28",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.49.0",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-parallax-tilt": "^1.7.333",
    "react-use": "^17.6.1",
    "tailwind-merge": "^3.6.0",
    "tanstack-theme-kit": "^0.2.1",
    "type-fest": "^5.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "latest",
    "@vitejs/plugin-react": "^6.0.3",
    "oxfmt": "0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
